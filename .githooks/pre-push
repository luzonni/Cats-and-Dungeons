#!/bin/sh
#
# Roda a CI inteira antes do push.
#
# Existe porque descobrir no GitHub custa caro: o push falha, chega e-mail, e o
# conserto vira mais um commit de "fix ci". Aqui o erro aparece antes de sair da
# maquina.
#
# Instalacao (uma vez por clone — o git nao versiona .git/hooks):
#     ./gradlew hooks
#
# Para pular num caso pontual:
#     git push --no-verify
#

# DEVELOP E MAIN NAO RECEBEM PUSH DIRETO. A develop so muda por PR com a CI verde,
# e a main so pela promocao automatica (ver docs/CONTRIBUINDO.md). O repositorio
# nao tem protecao de branch ligada no GitHub — so o dono poderia ligar —, entao
# esta e a trava que existe. A unica excecao e CRIAR a develop pela primeira vez.
#
# O git manda, por linha: <ref local> <sha local> <ref remota> <sha remota>.
ZEROS=0000000000000000000000000000000000000000
while read -r _ _ REF_REMOTA SHA_REMOTA; do
  case "$REF_REMOTA" in
    refs/heads/main|refs/heads/develop)
      if [ "$REF_REMOTA" = "refs/heads/develop" ] && [ "$SHA_REMOTA" = "$ZEROS" ]; then
        continue
      fi
      echo "[pre-push] push direto para ${REF_REMOTA#refs/heads/} recusado."
      echo "[pre-push] Abra um PR de uma branch de implementacao para a develop;"
      echo "[pre-push] a main recebe a develop sozinha quando a CI passa."
      exit 1 ;;
  esac
done

# Acha o java do mesmo jeito que o gradlew acha: JAVA_HOME primeiro, PATH depois.
# No Git Bash do Windows o java quase nunca esta no PATH, e um hook que morre com
# "command not found" e pior do que hook nenhum — ele vira uma etapa que todo
# mundo aprende a pular.
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA="$JAVA_HOME/bin/java"
elif [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java.exe" ]; then
  JAVA="$JAVA_HOME/bin/java.exe"
elif command -v java >/dev/null 2>&1; then
  JAVA=java
else
  echo "[pre-push] nao achei o java. Defina JAVA_HOME ou ponha o java no PATH."
  echo "[pre-push] push cancelado: sem java nao da para rodar a CI local."
  exit 1
fi

echo "[pre-push] rodando a CI local (git push --no-verify pula)"
"$JAVA" tools/CiLocal.java || {
  echo ""
  echo "[pre-push] push cancelado: a CI falharia."
  exit 1
}
